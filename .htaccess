# BEGIN clean-urls (generated by projects/glass-lab/tools/post-build.mjs, do not edit)
RewriteEngine On
RewriteBase /

# 301: old .html URLs -> clean URLs (only when the request itself asked for .html)
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/(?:index|pg-index)\.html[?\s]
RewriteRule ^(?:index|pg-index)\.html$ / [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/(?:legal-cookies|cookies)\.html[?\s]
RewriteRule ^(?:legal-cookies|cookies)\.html$ /cookies [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/(?:legal-privacidad|privacidad)\.html[?\s]
RewriteRule ^(?:legal-privacidad|privacidad)\.html$ /privacidad [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/(?:legal-terminos|terminos)\.html[?\s]
RewriteRule ^(?:legal-terminos|terminos)\.html$ /terminos [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/(?:pg-contacto|contacto)\.html[?\s]
RewriteRule ^(?:pg-contacto|contacto)\.html$ /contacto [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/(?:pg-laboratorio|laboratorio)\.html[?\s]
RewriteRule ^(?:pg-laboratorio|laboratorio)\.html$ /laboratorio [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/(?:pg-mobiliario|mobiliario)\.html[?\s]
RewriteRule ^(?:pg-mobiliario|mobiliario)\.html$ /mobiliario [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/(?:pg-mueble|mueble)\.html[?\s]
RewriteRule ^(?:pg-mueble|mueble)\.html$ /mueble [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/(?:pg-nosotros|nosotros)\.html[?\s]
RewriteRule ^(?:pg-nosotros|nosotros)\.html$ /nosotros [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/(?:pg-proyecto|proyecto)\.html[?\s]
RewriteRule ^(?:pg-proyecto|proyecto)\.html$ /proyecto [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/(?:pg-proyectos|proyectos)\.html[?\s]
RewriteRule ^(?:pg-proyectos|proyectos)\.html$ /proyectos [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/(?:pg-recursos|recursos)\.html[?\s]
RewriteRule ^(?:pg-recursos|recursos)\.html$ /recursos [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/(?:pg-sistema|sistema)\.html[?\s]
RewriteRule ^(?:pg-sistema|sistema)\.html$ /sistema [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/(?:pg-sistemas|sistemas)\.html[?\s]
RewriteRule ^(?:pg-sistemas|sistemas)\.html$ /sistemas [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/pg-testimonial\.html[?\s]
RewriteRule ^pg-testimonial\.html$ /testimonial [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/en/(?:index|pg-index)\.html[?\s]
RewriteRule ^en/(?:index|pg-index)\.html$ /en/ [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/en/(?:legal-cookies|cookies)\.html[?\s]
RewriteRule ^en/(?:legal-cookies|cookies)\.html$ /en/cookies [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/en/(?:legal-privacidad|privacidad)\.html[?\s]
RewriteRule ^en/(?:legal-privacidad|privacidad)\.html$ /en/privacidad [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/en/(?:legal-terminos|terminos)\.html[?\s]
RewriteRule ^en/(?:legal-terminos|terminos)\.html$ /en/terminos [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/en/(?:pg-contacto|contacto)\.html[?\s]
RewriteRule ^en/(?:pg-contacto|contacto)\.html$ /en/contacto [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/en/(?:pg-laboratorio|laboratorio)\.html[?\s]
RewriteRule ^en/(?:pg-laboratorio|laboratorio)\.html$ /en/laboratorio [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/en/(?:pg-mobiliario|mobiliario)\.html[?\s]
RewriteRule ^en/(?:pg-mobiliario|mobiliario)\.html$ /en/mobiliario [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/en/(?:pg-mueble|mueble)\.html[?\s]
RewriteRule ^en/(?:pg-mueble|mueble)\.html$ /en/mueble [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/en/(?:pg-nosotros|nosotros)\.html[?\s]
RewriteRule ^en/(?:pg-nosotros|nosotros)\.html$ /en/nosotros [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/en/(?:pg-proyecto|proyecto)\.html[?\s]
RewriteRule ^en/(?:pg-proyecto|proyecto)\.html$ /en/proyecto [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/en/(?:pg-proyectos|proyectos)\.html[?\s]
RewriteRule ^en/(?:pg-proyectos|proyectos)\.html$ /en/proyectos [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/en/(?:pg-recursos|recursos)\.html[?\s]
RewriteRule ^en/(?:pg-recursos|recursos)\.html$ /en/recursos [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/en/(?:pg-sistema|sistema)\.html[?\s]
RewriteRule ^en/(?:pg-sistema|sistema)\.html$ /en/sistema [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/en/(?:pg-sistemas|sistemas)\.html[?\s]
RewriteRule ^en/(?:pg-sistemas|sistemas)\.html$ /en/sistemas [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/en/pg-testimonial\.html[?\s]
RewriteRule ^en/pg-testimonial\.html$ /en/testimonial [R=301,L]

# trailing slash -> no slash
RewriteRule ^cookies/$ /cookies [R=301,L]
RewriteRule ^privacidad/$ /privacidad [R=301,L]
RewriteRule ^terminos/$ /terminos [R=301,L]
RewriteRule ^contacto/$ /contacto [R=301,L]
RewriteRule ^laboratorio/$ /laboratorio [R=301,L]
RewriteRule ^mobiliario/$ /mobiliario [R=301,L]
RewriteRule ^mueble/$ /mueble [R=301,L]
RewriteRule ^nosotros/$ /nosotros [R=301,L]
RewriteRule ^proyecto/$ /proyecto [R=301,L]
RewriteRule ^proyectos/$ /proyectos [R=301,L]
RewriteRule ^recursos/$ /recursos [R=301,L]
RewriteRule ^sistema/$ /sistema [R=301,L]
RewriteRule ^sistemas/$ /sistemas [R=301,L]
RewriteRule ^testimonial/$ /testimonial [R=301,L]
RewriteRule ^en/cookies/$ /en/cookies [R=301,L]
RewriteRule ^en/privacidad/$ /en/privacidad [R=301,L]
RewriteRule ^en/terminos/$ /en/terminos [R=301,L]
RewriteRule ^en/contacto/$ /en/contacto [R=301,L]
RewriteRule ^en/laboratorio/$ /en/laboratorio [R=301,L]
RewriteRule ^en/mobiliario/$ /en/mobiliario [R=301,L]
RewriteRule ^en/mueble/$ /en/mueble [R=301,L]
RewriteRule ^en/nosotros/$ /en/nosotros [R=301,L]
RewriteRule ^en/proyecto/$ /en/proyecto [R=301,L]
RewriteRule ^en/proyectos/$ /en/proyectos [R=301,L]
RewriteRule ^en/recursos/$ /en/recursos [R=301,L]
RewriteRule ^en/sistema/$ /en/sistema [R=301,L]
RewriteRule ^en/sistemas/$ /en/sistemas [R=301,L]
RewriteRule ^en/testimonial/$ /en/testimonial [R=301,L]

# serve each clean path from its file
RewriteRule ^cookies$ legal-cookies.html [L]
RewriteRule ^privacidad$ legal-privacidad.html [L]
RewriteRule ^terminos$ legal-terminos.html [L]
RewriteRule ^contacto$ pg-contacto.html [L]
RewriteRule ^laboratorio$ pg-laboratorio.html [L]
RewriteRule ^mobiliario$ pg-mobiliario.html [L]
RewriteRule ^mueble$ pg-mueble.html [L]
RewriteRule ^nosotros$ pg-nosotros.html [L]
RewriteRule ^proyecto$ pg-proyecto.html [L]
RewriteRule ^proyectos$ pg-proyectos.html [L]
RewriteRule ^recursos$ pg-recursos.html [L]
RewriteRule ^sistema$ pg-sistema.html [L]
RewriteRule ^sistemas$ pg-sistemas.html [L]
RewriteRule ^testimonial$ pg-testimonial.html [L]
RewriteRule ^en/cookies$ en/legal-cookies.html [L]
RewriteRule ^en/privacidad$ en/legal-privacidad.html [L]
RewriteRule ^en/terminos$ en/legal-terminos.html [L]
RewriteRule ^en/contacto$ en/pg-contacto.html [L]
RewriteRule ^en/laboratorio$ en/pg-laboratorio.html [L]
RewriteRule ^en/mobiliario$ en/pg-mobiliario.html [L]
RewriteRule ^en/mueble$ en/pg-mueble.html [L]
RewriteRule ^en/nosotros$ en/pg-nosotros.html [L]
RewriteRule ^en/proyecto$ en/pg-proyecto.html [L]
RewriteRule ^en/proyectos$ en/pg-proyectos.html [L]
RewriteRule ^en/recursos$ en/pg-recursos.html [L]
RewriteRule ^en/sistema$ en/pg-sistema.html [L]
RewriteRule ^en/sistemas$ en/pg-sistemas.html [L]
RewriteRule ^en/testimonial$ en/pg-testimonial.html [L]

ErrorDocument 404 /404.html
# END clean-urls
